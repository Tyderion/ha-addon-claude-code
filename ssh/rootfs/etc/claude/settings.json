{
  "statusLine": {
    "type": "command",
    "command": "/etc/claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Read(/homeassistant/**)",
      "Edit(/homeassistant/**)",
      "Read(/addon_configs/**)",
      "Edit(/addon_configs/**)",
      "Read(/addons/**)",
      "Read(/backup/**)",
      "Read(/media/**)",
      "Read(/share/**)",
      "Edit(/share/**)",
      "Read(/ssl/**)",
      "Bash(ha *)",
      "Bash(yamllint *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(sqlite3 *)",
      "Bash(python3 *)",
      "Bash(curl -s -X GET http://supervisor/*)",
      "Bash(curl -s http://supervisor/*)",
      "Bash(ha-reload)",
      "Bash(ha-entities *)",
      "Bash(ha-dashboard *)",
      "Bash(ha-trace *)",
      "Bash(ha-history *)",
      "Bash(ha-template *)",
      "Bash(ha-service *)",
      "Read(//tmp/*.json)",
      "Edit(//tmp/*.json)",
      "Bash(bluetoothctl *)"
    ],
    "ask": [
      "Bash(*--unsafe*)",
      "Bash(ha core restart*)",
      "Bash(ha core stop*)",
      "Bash(ha core update*)",
      "Bash(ha host reboot*)",
      "Bash(ha host shutdown*)",
      "Bash(ha backup restore*)",
      "Bash(ha backups restore*)",
      "Bash(ha addons uninstall*)",
      "Bash(ha addons stop*)",
      "Bash(ha os update*)",
      "Bash(ha supervisor update*)",
      "Bash(curl -s -X POST http://supervisor/*)",
      "Bash(curl -X POST http://supervisor/*)"
    ],
    "deny": [
      "Bash(./ha-entities*)",
      "Bash(./ha-dashboard*)",
      "Bash(./ha-trace*)",
      "Bash(./ha-history*)",
      "Bash(./ha-template*)",
      "Bash(./ha-service*)",
      "Bash(./ha-reload*)"
    ]
  }
}
