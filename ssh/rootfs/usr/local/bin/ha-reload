#!/usr/bin/env bash
# Reload Home Assistant YAML configuration (hot reload, no restart)
# Equivalent to Developer Tools → YAML → Quick Reload
#
# Reloads all hot-reloadable YAML domains at once (all-or-nothing); see the
# HomeAssistantReload skill for the full domain list.
#
# Use 'ha core restart' only for: new integrations, logger, recorder, http changes

set -euo pipefail

usage() {
    echo "Usage: ha-reload"
    echo "Reloads all hot-reloadable YAML domains at once (takes no arguments)."
}

if [ "$#" -gt 0 ]; then
    case "$1" in
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Error: ha-reload takes no arguments" >&2
            usage >&2
            exit 2
            ;;
    esac
fi

if [ -z "${SUPERVISOR_TOKEN:-}" ]; then
    echo "Error: SUPERVISOR_TOKEN not set" >&2
    exit 1
fi

echo "Reloading Home Assistant configuration..."

response=$(curl -s -w "\n%{http_code}" -X POST \
    --connect-timeout 5 --max-time 120 \
    -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    -H "Content-Type: application/json" \
    -d '{}' \
    http://supervisor/core/api/services/homeassistant/reload_all) \
    || {
        echo "Error: cannot reach the Supervisor API (curl exit $?)" >&2
        exit 1
    }

http_code=$(echo "$response" | tail -n1)

if [ "$http_code" -ge 200 ] 2> /dev/null && [ "$http_code" -lt 300 ]; then
    echo "Reloaded all hot-reloadable YAML domains"
    echo "Note: per-domain errors appear only in 'ha core logs'"
else
    echo "Failed to reload configuration (HTTP $http_code)" >&2
    echo "$response" | sed '$d' >&2
    exit 1
fi
